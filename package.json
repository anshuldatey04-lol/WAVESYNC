{
  "name": "syncwave",
  "private": true,
  "version": "0.1.0",
  "description": "Synchronized multi-device audio playback for one authorized file.",
  "author": "SYNCWAVE",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "server": "node server/index.cjs",
    "server:dev": "node --watch server/index.cjs",
    "desktop": "electron .",
    "desktop:dev": "electron . --dev",
    "dist": "npm run build && electron-builder",
    "smoke": "node smoke-test.mjs"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/qrcode": "^1.5.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react": "^7.37.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.7.2",
    "vite": "^6.0.11"
  },
  "build": {
    "appId": "com.syncwave.desktop",
    "productName": "SYNCWAVE",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
