# Backend (Express + Socket.IO signaling / room coordination)
VITE_SERVER_URL=http://localhost:8787

# WebRTC (optional TURN relay for strict NATs)
# VITE_TURN_URL=
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

# Spotify (optional, separate integration — never retransmits Spotify audio)
# Create a Spotify app with the redirect URI set to this app's origin and enable the Web Playback/Playback State scopes.
# VITE_SPOTIFY_CLIENT_ID=
